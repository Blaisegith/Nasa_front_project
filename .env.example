# =============================================================================
# TechLabs — variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs.
# Ne jamais committer `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_NAME=TechLabs API

# Chaîne aléatoire longue, OBLIGATOIRE en production.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_SECRET_KEY=dev-only-insecure-key-change-me

# Sessions
SESSION_COOKIE_NAME=techlabs_session
SESSION_TTL_HOURS=168
# Mettre à true derrière HTTPS (obligatoire en production).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Origines autorisées pour CORS (séparées par des virgules).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limitation de débit sur /api/v1/auth (requêtes par minute et par IP).
RATE_LIMIT_PER_MINUTE=20

# -----------------------------------------------------------------------------
# Base de données
# -----------------------------------------------------------------------------
# Développement local :
DATABASE_URL=sqlite+aiosqlite:///./techlabs.db
# Supabase (exemple, via le pooler) :
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Supabase — jamais exposé au navigateur, sauf l'anon key si un accès direct
# est prévu (ce n'est pas le cas dans l'architecture actuelle).
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stockage des avatars
# -----------------------------------------------------------------------------
AVATAR_DIR=./var/avatars
AVATAR_MAX_BYTES=2097152
AVATAR_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# RAG / ChromaDB — NON BRANCHÉ pour l'instant
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./var/chroma
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# Collections logiques :
#   nasa_scientific_corpus  -> corpus scientifique commun
#   user_documents          -> documents privés, filtrés par user_id côté serveur

# -----------------------------------------------------------------------------
# Fournisseur génératif — NON BRANCHÉ pour l'instant
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Vite) — tout ce qui est exposé au navigateur
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=